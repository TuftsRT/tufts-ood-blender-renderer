<%
@partition_filter = :gpu
_partial_path = File.expand_path('partials/resource_discovery.erb', __dir__)
_resource_result = ERB.new(File.read(_partial_path)).result(binding)

if (OodSupport::User.new.groups.map(&:name) & ['hpctools', 'blender']).any?
  max_slots = 6
else
  max_slots = 2
end
%>

---
cluster: "pax" #Set to your cluster name

bc_dynamic_js: true

form:
  - bc_num_hours
  - num_cores
  - num_memory
  - partition
  - gpu_type
  - bc_num_slots
  - version
  - projectfile
  - outputdir
  - start_frame
  - end_frame

attributes:
<%= generate_partition_field.indent(2) %>
<%= generate_num_cores_field.indent(2) %>
<%= generate_num_memory_field.indent(2) %>
<%= generate_gpu_type_field.indent(2) %>
<%= generate_num_hours_field.indent(2) %>

  version:
    label: Blender Version
    widget: select
    options:
      - ["4.2.5", "modtree/deprecated blender/4.2.5 cuda/11.7"] # Our clusters modules, you probably need to change these for your own cluster, see Readme.md.

  bc_num_slots:
    min: 1
    max: <%= max_slots %>

  projectfile:
    label: Blender Project File
    widget: path_selector
    required: true

  outputdir:
    label: "Render output directory"
    widget: path_selector
    required: true
    show_files: false
    help: "Specifies the output directory for storing your rendered frames. If left unset, it defaults to a output folder in the same folder as your selected project file, if you have mutliple project files in the same folder, make sure to specific a clean output folder for each run. Please make sure the output folder is fresh and has no hidden .lock files."


  start_frame:
    label: "Start at frame number"
    help: "Enter the number of the frame to start at.  First frame is 1."
    value: "1"
    min: 1

  end_frame:
    label: "End at frame number"
    help: "Enter the number of the frame to end at.  Leave blank to render to the last frame."
    value: ""