batch_connect:
  template: "basic"

script:
  job_name: "Blender_renderer"
  native:
    - "--nodes=<%= bc_num_slots %>"
    - "--ntasks=<%= bc_num_slots.to_i %>"
    - "--cpus-per-task=<%= num_cores %>"
    - "--mem=<%= num_memory %>G"
    - "--time=<%= bc_num_hours %>:00:00"
    - "--partition=<%= partition %>"
    - "--error=output.err"
    - "--error=output.err"
<%
  selected_gpu = gpu_type.to_s.strip
  gres_name = selected_gpu.split('-', 2).first unless selected_gpu.empty? || selected_gpu == 'none' || selected_gpu == 'any'
%>
<% if selected_gpu == 'any' %>
    - "--gres=gpu:1"
<% elsif gres_name %>
    - "--gres=gpu:<%= gres_name %>:1"
<% if selected_gpu.include?('-') %>
    - "--constraint=<%= selected_gpu %>"
<% end %>
<% end %>
<%-
  # QOS rules live in the shared partition_qos.rb (preempt -> preempt,
  # lab partitions -> normal-contrib, interactive only where allowed).
  load '/etc/ood/config/apps/dashboard/batch_connect/partials/partition_qos.rb'
  qos = PartitionQos.qos_for(partition, (ta_qos if defined?(ta_qos)))
-%>
<%- if qos -%>
    - "--qos=<%= qos %>"
<%- end -%>
